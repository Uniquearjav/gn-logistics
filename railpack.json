{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "pnpm install --frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        "pnpm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm run start"
  }
}
